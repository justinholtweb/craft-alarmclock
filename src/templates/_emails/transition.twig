{% set label = transition.label|lower %}
{% set siteName = site ? site.name : "the site" %}

<div style="font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.5; color: #12203A;">
    <p style="margin: 0 0 16px;">
        <strong>{{ transition.title ?? "Element #{transition.elementId}" }}</strong>
        {{ label }} on {{ siteName }}.
    </p>

    {% if transition.url %}
        <p style="margin: 0 0 16px;">
            <a href="{{ transition.url }}" style="color: #B8860B;">{{ transition.url }}</a>
        </p>
    {% endif %}

    <table cellpadding="0" cellspacing="0" style="font-size: 13px; color: #4A5568;">
        <tr>
            <td style="padding: 2px 16px 2px 0;">Scheduled for</td>
            <td style="padding: 2px 0;">{{ transition.scheduledFor ? transition.scheduledFor|datetime('short') : '—' }}</td>
        </tr>
        <tr>
            <td style="padding: 2px 16px 2px 0;">Noticed at</td>
            <td style="padding: 2px 0;">
                {{ transition.detectedAt ? transition.detectedAt|datetime('short') : '—' }}
                {%- if transition.latency is not null %} ({{ transition.latency }}s later){% endif %}
            </td>
        </tr>
        {% if element %}
            <tr>
                <td style="padding: 2px 16px 2px 0;">Edit</td>
                <td style="padding: 2px 0;"><a href="{{ element.getCpEditUrl() }}" style="color: #B8860B;">{{ element.getCpEditUrl() }}</a></td>
            </tr>
        {% endif %}
    </table>

    <p style="margin: 24px 0 0; font-size: 12px; color: #8A94A6;">
        Sent by Alarm Clock.
    </p>
</div>
